# =============================================================================
# IAS Transfer Intelligence Dashboard — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the secrets. Every variable here maps
# 1:1 to backend/app/core/config.py (defaults shown). The backend reads
# backend/.env, then the repo-root .env. docker-compose.yml overrides the
# database/storage entries for the containerised stack.
#
# Generate the two required secrets:
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=IAS Transfer Intelligence Dashboard
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (the dashboard URL(s)).
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Security ----------------------------------------------------------------
# REQUIRED. JWT signing key. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# First admin is created on startup; use these to log in to the dashboard.
FIRST_ADMIN_EMAIL=admin@digitallearning.in
FIRST_ADMIN_PASSWORD=ChangeMe123!
# REQUIRED. Fernet key for at-rest encryption of API keys stored via the Settings page.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ----------------------------------------------------------------
# Two URLs for the same database: asyncpg for the API, psycopg2 for the pipeline.
# Local Postgres shown; docker-compose points these at its `db` service.
# Supabase (production): use the Session Pooler host and user, e.g.
#   postgresql+asyncpg://postgres.<project-ref>:<pw>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
# (the direct db.<ref>.supabase.co host is IPv6-only and unreachable from HF Spaces).
DATABASE_URL=postgresql+asyncpg://ias:ias_password@localhost:5432/ias_transfers
DATABASE_URL_SYNC=postgresql+psycopg2://ias:ias_password@localhost:5432/ias_transfers
# Require TLS to the database. Set true for managed Postgres (Supabase/Neon).
DB_SSL=false

# --- Scheduling --------------------------------------------------------------
# Shared secret for the cron-triggered endpoint POST /api/v1/agents/run-cycle
# (header `x-cron-token`). Leave empty to disable that endpoint (always 401).
CRON_TOKEN=
# Run the discovery cycle on a background thread INSIDE the API process (APScheduler):
# every DISCOVERY_INTERVAL_SECONDS plus once shortly after boot. Set false only if
# an external scheduler drives /agents/run-cycle exclusively.
ENABLE_INPROCESS_SCHEDULER=true

# --- Discovery ---------------------------------------------------------------
# Cadence (seconds) of the discovery cycle. 3600 = hourly (minimum 60).
DISCOVERY_INTERVAL_SECONDS=3600
# How far back Google News queries look. Rounded up to whole days and never
# below 2 days so consecutive runs overlap.
DISCOVERY_LOOKBACK_HOURS=48
# Articles taken per feed, and processed per batch inside one cycle.
DISCOVERY_MAX_ARTICLES_PER_RUN=80
# Resolve Google News redirect links to the publisher URL so the article body
# can be fetched (much better extraction than headline-only).
DISCOVERY_RESOLVE_GOOGLE_LINKS=true
DISCOVERY_MAX_LINK_RESOLUTIONS_PER_RUN=60
# Wall-clock budget (seconds) for processing pending articles inside one cycle;
# leftovers are picked up (newest first) by the next cycle.
CYCLE_TIME_BUDGET_SECONDS=1500
# Web-enrichment of incomplete records: records per cycle, and attempts per
# record before it is left as "no info".
ENRICHMENT_BATCH_SIZE=25
ENRICHMENT_MAX_ATTEMPTS=2
# News-feed retention: articles older than this (by discovery time) are purged
# each cycle; the transfer records extracted from them are kept.
NEWS_RETENTION_DAYS=15
# Comma-separated languages for Google News (e.g. "en,hi,ta").
DISCOVERY_LANGUAGES=en,hi
HTTP_USER_AGENT=IASTransferIntelligenceBot/1.0 (+https://digitallearning.in; research)
HTTP_TIMEOUT_SECONDS=20
RESPECT_ROBOTS_TXT=true

# --- LLM / extraction --------------------------------------------------------
# Provider: openai (default) | anthropic
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_INPUT_CHARS=16000

# OpenAI (default). Set here or via the dashboard Settings page.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude (only if LLM_PROVIDER=anthropic) — official Anthropic SDK.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Reasoning effort for Claude calls: low, medium, high, xhigh or max.
ANTHROPIC_EFFORT=medium

# --- RAG assistant (/assistant page, POST /api/v1/chat/ask) ------------------
# OpenAI embedding model used to retrieve relevant transfer records.
EMBED_MODEL=text-embedding-3-small
# How many records to ground each answer on, and the max context size.
CHAT_TOP_K=8
CHAT_MAX_CONTEXT_CHARS=6000
# The assistant uses the configured chat model (OPENAI_MODEL by default).
CHAT_MAX_TOKENS=800
CHAT_TIMEOUT_SECONDS=60
# Below this best semantic similarity the local data is considered not to
# cover the question and a live web search is used instead (if enabled).
CHAT_MIN_SIM=0.5
ENABLE_WEB_FALLBACK=true

# --- Multimodal / OCR --------------------------------------------------------
# OCR of scanned government orders needs the Tesseract + Poppler binaries,
# which the backend image does not include. Off by default; fails soft.
ENABLE_OCR=false
OCR_LANGUAGES=eng+hin
# Paths to the binaries when ENABLE_OCR=true on a self-hosted backend.
TESSERACT_CMD=
POPPLER_PATH=

# --- Google Sheets -----------------------------------------------------------
# Service-account JSON path (uploaded via the Settings page, or written from
# GOOGLE_CREDENTIALS_JSON at boot).
GOOGLE_CREDENTIALS_FILE=/data/secrets/google-credentials.json
# Full service-account JSON as a single line. Use on ephemeral hosts (HF Spaces)
# so credentials survive restarts. Leave blank to rely on the uploaded file.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Transfers
# Export verified records to the sheet automatically during each cycle.
GOOGLE_SHEETS_AUTO_EXPORT=true

# --- Notifications (all OPTIONAL) --------------------------------------------
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Records at/above this confidence trigger high-confidence alerts.
HIGH_CONFIDENCE_THRESHOLD=0.85

# --- Storage / processing ----------------------------------------------------
STORAGE_DIR=/data/storage
MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=1800
