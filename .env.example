# =============================================================================
# IAS Transfer Intelligence Dashboard — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the secrets. Defaults below are wired
# to the docker-compose service names (db, redis, ollama) so the stack works
# out of the box. Every variable here maps 1:1 to backend/app/core/config.py.
#
# Generate the two required secrets:
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=IAS Transfer Intelligence Dashboard
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (the dashboard URL).
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Security ----------------------------------------------------------------
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# First admin is created on startup; use these to log in to the dashboard.
FIRST_ADMIN_EMAIL=admin@digitallearning.in
FIRST_ADMIN_PASSWORD=ChangeMe123!
# REQUIRED. Fernet key for at-rest encryption of API keys stored in the DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ----------------------------------------------------------------
# Host "db" matches the compose service. For local-without-docker use localhost.
DATABASE_URL=postgresql+asyncpg://ias:ias_password@db:5432/ias_transfers
DATABASE_URL_SYNC=postgresql+psycopg2://ias:ias_password@db:5432/ias_transfers

# --- Redis / Celery ----------------------------------------------------------
# Host "redis" matches the compose service.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Discovery ---------------------------------------------------------------
# News Discovery Agent cadence (seconds). 600 = every 10 minutes.
DISCOVERY_INTERVAL_SECONDS=600
DISCOVERY_LOOKBACK_HOURS=24
DISCOVERY_MAX_ARTICLES_PER_RUN=80
# Comma-separated languages for Google News (e.g. "en,hi,ta").
DISCOVERY_LANGUAGES=en,hi
HTTP_USER_AGENT=IASTransferIntelligenceBot/1.0 (+https://digitallearning.in; research)
HTTP_TIMEOUT_SECONDS=20
RESPECT_ROBOTS_TXT=true

# --- LLM / extraction --------------------------------------------------------
# Provider: ollama (default, open-source, offline) | openai | anthropic
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=16000

# Ollama (default, open-source). Two options:
#  A) Use the Ollama already running on your HOST (recommended; no image pull).
#     Containers reach it via host.docker.internal (mapped in docker-compose.yml):
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#  B) Use the optional containerized Ollama instead:
#       docker compose --profile with-ollama up -d ollama
#       docker compose exec ollama ollama pull llama3.2:3b
#     ...then set: OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# OpenAI (OPTIONAL — only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude (OPTIONAL — only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-opus-4-8

# --- Multimodal / OCR --------------------------------------------------------
ENABLE_OCR=true
OCR_LANGUAGES=eng+hin

# --- Google Sheets -----------------------------------------------------------
# Service-account JSON is uploaded via the Settings page to this shared path.
GOOGLE_CREDENTIALS_FILE=/data/secrets/google-credentials.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Transfers
GOOGLE_SHEETS_AUTO_EXPORT=true

# --- Notifications (all OPTIONAL) --------------------------------------------
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Records at/above this confidence trigger high-confidence alerts.
HIGH_CONFIDENCE_THRESHOLD=0.85

# --- Storage / processing ----------------------------------------------------
STORAGE_DIR=/data/storage
MAX_RETRIES=3
TASK_TIMEOUT_SECONDS=1800
