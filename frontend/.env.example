# Frontend environment (Next.js).
#
# On Vercel: add this as a Project Environment Variable (do NOT commit a real .env).
# Point it at your deployed backend (FastAPI on Render/Railway/Fly), e.g.
#   NEXT_PUBLIC_API_BASE_URL=https://ias-backend.onrender.com
#
# For local dev it defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
